# Cloudflare Pages response headers (https://developers.cloudflare.com/pages/configuration/headers/)
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()

# Keep the production *.pages.dev hostname out of search results (the custom domain is the real site).
https://panorama-rugove.pages.dev/*
  X-Robots-Tag: noindex
